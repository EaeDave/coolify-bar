{
  "schemaVersion": 1,
  "id": "eaedave.coolify",
  "name": "Coolify",
  "version": "1.0.1",
  "author": "EaeDave",
  "license": "MIT",
  "description": "Watch Coolify deployments from the Omarchy bar: running builds, recent history, and failures.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Coolify",
    "description": "A bar icon for running Coolify deployments, with a panel of recent and failed deploys.",
    "category": "Development",
    "aliases": ["coolify", "deploy", "deploys"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sources": [],
      "refreshIntervalSec": 30,
      "iconAlwaysUnlit": false,
      "notificationsEnabled": true,
      "notificationSoundEnabled": true,
      "linkBehavior": "Web app window"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "linkBehavior",
        "type": "enum",
        "label": "Open links",
        "options": ["Browser tab", "Web app window"],
        "defaultValue": "Web app window"
      },
      {
        "key": "iconAlwaysUnlit",
        "type": "boolean",
        "label": "Keep the bar icon unlit",
        "defaultValue": false
      },
      {
        "key": "notificationsEnabled",
        "type": "boolean",
        "label": "Desktop notifications",
        "defaultValue": true
      },
      {
        "key": "notificationSoundEnabled",
        "type": "boolean",
        "label": "Notification sound",
        "defaultValue": true
      }
    ]
  }
}
